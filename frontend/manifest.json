{
  "manifest_version": 3,
  "name": "PAROKSH \u2014 AI Browser Agent",
  "version": "1.0.0",
  "description": "Advanced Vision-AI Agent with Trusted Input and Anti-Loop logic.",
  "icons": {
    "16": "frontend/icons/icon16.png",
    "32": "frontend/icons/icon32.png",
    "48": "frontend/icons/icon48.png",
    "128": "frontend/icons/icon128.png"
  },
  "action": {
    "default_title": "PAROKSH \u2014 AI Browser Agent (click to open)",
    "default_icon": {
      "16": "frontend/icons/icon16.png",
      "32": "frontend/icons/icon32.png",
      "48": "frontend/icons/icon48.png",
      "128": "frontend/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "extension-core/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "debugger",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "extension-core/privacy-shield.bundle.js",
        "local-vision/qwen/local-vision-manager.js",
        "extension-core/action-executor.js",
        "extension-core/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "frontend/popup.html",
        "frontend/assets/*",
        "frontend/icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "local-vision/qwen-worker.bundle.js",
        "local-vision/model/Qwen3.5-0.8B-ONNX/*",
        "local-vision/model/Qwen3.5-0.8B-ONNX/onnx/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}